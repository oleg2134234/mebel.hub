# Claude API key (required). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used by the bot. Defaults to claude-opus-5 if unset.
# For high chat volume, claude-sonnet-5 is cheaper with strong quality.
CLAUDE_MODEL=claude-opus-5

# Port the backend listens on.
PORT=3001

# Comma-separated list of origins allowed to call the API, e.g.
# https://sytnie-ugodya.ru,https://www.sytnie-ugodya.ru
# Leave empty during local development to allow any origin.
ALLOWED_ORIGINS=

# --- Telegram (one bot, two roles) -----------------------------------------
# Create a bot via @BotFather in Telegram to get TELEGRAM_BOT_TOKEN.
#
# 1) Lead notifications (business-facing): TELEGRAM_CHAT_ID is the chat that
#    receives a message every time the bot captures a lead — your own chat
#    with the bot, or a group's. Find your chat ID with a bot like
#    @userinfobot, or by messaging your bot once and checking
#    https://api.telegram.org/bot<TOKEN>/getUpdates.
#
# 2) Customer-facing chat (optional): set TELEGRAM_CUSTOMER_BOT=true to let
#    anyone who opens the bot on Telegram talk to it directly — same
#    knowledge and lead-capture behavior as the website widget. Off by
#    default so an existing notifications-only setup doesn't suddenly start
#    answering strangers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CUSTOMER_BOT=false

# Email (SMTP): used both for new-lead notifications (LEADS_EMAIL_TO) and for
# the admin panel's manual broadcast feature.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL_TO=

# --- Admin panel (/admin) ---------------------------------------------------
# HTTP Basic Auth credentials. The admin panel is disabled (503) until both
# are set.
ADMIN_USER=
ADMIN_PASS=
